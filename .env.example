# Groq API key (FREE): https://console.groq.com/keys
#
# Copy this file to .env.local and paste your key below.
# There is deliberately NO "VITE_" prefix: only the server (Vite's dev server locally,
# the /api/llm function on Vercel) reads this. Vite never puts it in the browser code.
GROQ_API_KEY=your_groq_api_key_here
